# Copy to the right place and fill in. NEVER commit real values.
# See docs/07-security/security-and-privacy.md §5.4 for where each secret lives.

# ---- Frontend (apps/web/.env.local) — PUBLIC values only ----
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-or-publishable-key

# ---- Edge Function secrets (supabase/functions/.env locally; `supabase secrets set` in cloud) ----
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
APP_ORIGIN=http://localhost:5173
JOB_RUNNER_SECRET=replace-with-long-random-string

# Day 2+ (leave empty until then)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Day 3+ (leave empty until then)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
